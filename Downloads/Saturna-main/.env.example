# Copia este archivo a .env  (NUNCA subas .env a Git)

# --- Base de datos (PostgreSQL de docker-compose) ---
POSTGRES_USER=saturna
POSTGRES_PASSWORD=saturna
POSTGRES_DB=saturna
# Para correr la API fuera de Docker contra el Postgres de Docker:
DATABASE_URL=postgresql+psycopg://saturna:saturna@localhost:5432/saturna
# Sin Docker (solo desarrollo rápido): DATABASE_URL=sqlite:///./saturna.db

# --- Seguridad ---
# development | test | production
ENVIRONMENT=development
# Obligatorio en production: mínimo 32 caracteres
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_32_CARACTERES
# Duración de sesiones
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
# Vigencia predeterminada de los QR
QR_TOKEN_TTL_HOURS=24
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# URL pública de la API (WhatsApp descarga la imagen del QR desde aquí; en desarrollo usa la URL de ngrok)
PUBLIC_BASE_URL=http://localhost:8000

# --- WhatsApp Cloud API (vacío = modo simulado: los mensajes solo se registran en el log) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=saturna-verify
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE_ARRIVAL=aviso_llegada

# --- Agente de IA (vacío = agente por reglas, sin costo) ---
LLM_API_KEY=
LLM_MODEL=claude-haiku-5-5
